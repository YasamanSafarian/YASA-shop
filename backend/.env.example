DATABASE_URL="postgresql://perfume:123456@localhost:5433/perfume_shop?schema=public"

PORT=3000

# Generate your own secrets, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
# Access token TTL in seconds (1800 = 30 minutes)
JWT_ACCESS_EXPIRES_IN=1800

JWT_REFRESH_SECRET="change-me-refresh-secret"
# Refresh token TTL in seconds (604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_ROUNDS=10
